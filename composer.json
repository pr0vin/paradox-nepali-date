{
  "name": "paradox/nepali-date",
  "description": "A Laravel package for Bikram Sambat (BS) and Gregorian (AD) date conversion.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Paradox\\NepaliDate\\": "src/"
    }
  },
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "nesbot/carbon": "^3.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Paradox\\NepaliDate\\NepaliDateServiceProvider"
      ]
    }
  }
}
